{
  "version": "2.0",
  "types": {
    "item": "item id or tag:<item tag>",
    "block": "block id or tag:<block tag>",
    "mob": "mob kind (bare id): cow, zombie, villager",
    "entity": "#kind, #kind.<id>, #player.<name>",
    "target": "pos | @place | #entity | block/item id or tag (nearest known)",
    "pos": "(x,y,z), coords absolute or ~relative",
    "posset": "pos | [pos,...] | box | front | below | above",
    "box": "((x,y,z),(x,y,z)) inclusive",
    "dir": "north | south | east | west | up | down",
    "int": "integer",
    "num": "integer or decimal",
    "duration": "30s, 2m, 1h",
    "text": "\"quoted string\"",
    "query": "\"quoted string\" or a bare name",
    "name": "new identifier [a-z0-9_]",
    "biome": "biome id",
    "prefer": "unexplored | biome:<biome> | block id or tag",
    "item_list": "item or [item,...]",
    "cond": "condition (see dsl.md 3)",
    "stmt": "statement, takes the rest of the line"
  },
  "global_kw": {"timeout": "duration", "max": "int"},
  "verbs": {
    "goto":        {"family": "movement", "args": [{"name": "target", "type": "target"}], "kw": {"dist": "num"}, "doc": "path to a target, ends within dist (default 1)"},
    "follow":      {"family": "movement", "args": [{"name": "target", "type": "entity"}], "kw": {"dist": "num"}, "doc": "keep within dist of an entity until stopped"},
    "flee":        {"family": "movement", "args": [{"name": "from", "type": "target"}], "kw": {"dist": "num"}, "doc": "run away until dist (default 16) from the target"},
    "explore":     {"family": "movement", "args": [], "kw": {"dir": "dir", "radius": "int", "prefer": "prefer"}, "doc": "walk into unseen terrain"},
    "descend":     {"family": "movement", "args": [], "kw": {"to_y": "int", "mode": {"enum": ["stairs", "shaft"]}}, "doc": "dig down (stairs by default)"},
    "ascend":      {"family": "movement", "args": [], "kw": {"to_y": "int"}, "doc": "staircase up (to open sky by default)"},
    "pillar":      {"family": "movement", "args": [{"name": "n", "type": "int"}], "kw": {"block": "block"}, "doc": "jump-place n blocks under itself"},
    "bridge":      {"family": "movement", "args": [{"name": "dir", "type": "dir"}, {"name": "n", "type": "int"}], "kw": {"block": "block"}, "doc": "sneak-place a bridge n blocks"},
    "swim_up":     {"family": "movement", "args": [], "kw": {}, "doc": "swim to the surface"},
    "look":        {"family": "movement", "args": [{"name": "target", "type": "target"}], "kw": {}, "doc": "turn the head toward a target"},
    "wander":      {"family": "movement", "args": [], "kw": {"radius": "int"}, "doc": "random walk nearby"},

    "mine":        {"family": "gathering", "args": [{"name": "block", "type": "block"}], "kw": {"n": "int", "near": "target", "tool": "item"}, "doc": "find and mine n blocks (default 1), collects drops"},
    "chop":        {"family": "gathering", "args": [], "kw": {"n": "int", "species": "block"}, "doc": "fell n trees (whole trunk)"},
    "strip_mine":  {"family": "gathering", "args": [{"name": "dir", "type": "dir"}], "kw": {"len": "int", "y": "int"}, "doc": "straight 1x2 tunnel"},
    "branch_mine": {"family": "gathering", "args": [], "kw": {"len": "int", "spacing": "int", "y": "int"}, "doc": "main tunnel with side branches"},
    "dig":         {"family": "gathering", "args": [{"name": "area", "type": "box"}], "kw": {}, "doc": "clear every block in a cuboid"},
    "break":       {"family": "gathering", "args": [{"name": "at", "type": "posset"}], "kw": {}, "doc": "break the block(s) at positions"},
    "collect":     {"family": "gathering", "args": [{"name": "item", "type": "item", "opt": true}], "kw": {"radius": "int"}, "doc": "pick up dropped items"},
    "harvest":     {"family": "gathering", "args": [{"name": "crop", "type": "block"}], "kw": {"n": "int", "replant": {"enum": ["yes", "no"]}}, "doc": "harvest grown crops"},
    "fish":        {"family": "gathering", "args": [], "kw": {"n": "int"}, "doc": "fish with a rod"},
    "shear":       {"family": "gathering", "args": [{"name": "target", "type": "entity|mob"}], "kw": {}, "doc": "shear a sheep"},
    "milk":        {"family": "gathering", "args": [{"name": "target", "type": "entity|mob"}], "kw": {}, "doc": "fill a bucket with milk"},

    "craft":       {"family": "craft", "args": [{"name": "item", "type": "item"}], "kw": {"n": "int"}, "doc": "craft n items (default 1), uses a nearby crafting table when needed"},
    "smelt":       {"family": "craft", "args": [{"name": "input", "type": "item"}], "kw": {"n": "int", "fuel": "item"}, "doc": "furnace"},
    "blast":       {"family": "craft", "args": [{"name": "input", "type": "item"}], "kw": {"n": "int", "fuel": "item"}, "doc": "blast furnace"},
    "smoke":       {"family": "craft", "args": [{"name": "input", "type": "item"}], "kw": {"n": "int", "fuel": "item"}, "doc": "smoker"},
    "enchant":     {"family": "craft", "args": [{"name": "item", "type": "item"}], "kw": {"level": "int"}, "doc": "enchanting table, level = slot 1-3"},
    "repair":      {"family": "craft", "args": [{"name": "item", "type": "item"}], "kw": {"with": "item"}, "doc": "anvil or grindstone"},
    "brew":        {"family": "craft", "args": [{"name": "potion", "type": "name"}], "kw": {"n": "int"}, "doc": "brewing stand"},
    "stonecut":    {"family": "craft", "args": [{"name": "input", "type": "item"}, {"name": "output", "type": "item"}], "kw": {"n": "int"}, "doc": "stonecutter"},
    "smith":       {"family": "craft", "args": [{"name": "base", "type": "item"}, {"name": "addition", "type": "item"}], "kw": {"template": "item"}, "doc": "smithing table"},
    "trade":       {"family": "craft", "args": [{"name": "with", "type": "entity"}, {"name": "offer", "type": "int"}], "kw": {"n": "int"}, "doc": "villager trade, offer = index in the trade list"},

    "place":       {"family": "build", "args": [{"name": "block", "type": "block"}], "kw": {"at": "posset", "face": "dir"}, "doc": "place block(s); no predefined structures, builds are designed by the model"},
    "use":         {"family": "build", "args": [{"name": "item", "type": "item", "opt": true}], "kw": {"on": "target"}, "doc": "right-click: hold item (or empty hand) and use it on a block/entity (door, lever, bucket, flint_and_steel...)"},

    "attack":      {"family": "combat", "args": [{"name": "target", "type": "entity|mob"}], "kw": {}, "doc": "one hit"},
    "fight":       {"family": "combat", "args": [{"name": "target", "type": "entity|mob"}], "kw": {}, "doc": "melee until the target dies or until()"},
    "shoot":       {"family": "combat", "args": [{"name": "target", "type": "entity|mob"}], "kw": {"n": "int"}, "doc": "bow/crossbow"},
    "shield":      {"family": "combat", "args": [], "kw": {"dur": "duration"}, "doc": "raise the shield"},
    "retreat":     {"family": "combat", "args": [], "kw": {"to": "target"}, "doc": "back off from the fight (to a target or away)"},
    "avoid":       {"family": "combat", "args": [{"name": "target", "type": "entity|mob"}], "kw": {"radius": "int"}, "doc": "keep away from it while doing other things, until stopped"},
    "eat":         {"family": "combat", "args": [{"name": "food", "type": "item", "opt": true}], "kw": {}, "doc": "eat (best food by default)"},
    "sleep":       {"family": "combat", "args": [], "kw": {"at": "target"}, "doc": "use a bed"},
    "equip_best":  {"family": "combat", "args": [], "kw": {"slot": {"enum": ["armor", "weapon", "tool"]}}, "doc": "equip best gear"},
    "set_spawn":   {"family": "combat", "args": [], "kw": {"at": "target"}, "doc": "set respawn point (bed / anchor)"},
    "water_bucket_save": {"family": "combat", "args": [], "kw": {}, "doc": "place water under itself while falling"},
    "extinguish":  {"family": "combat", "args": [], "kw": {}, "doc": "put out fire on itself"},

    "equip":       {"family": "inventory", "args": [{"name": "item", "type": "item"}], "kw": {"slot": {"enum": ["hand", "offhand", "head", "chest", "legs", "feet"]}}, "doc": "hold or wear"},
    "drop":        {"family": "inventory", "args": [{"name": "item", "type": "item"}], "kw": {"n": "int"}, "doc": "throw items"},
    "store":       {"family": "inventory", "args": [], "kw": {"chest": "target", "filter": "item_list"}, "doc": "put items into a chest"},
    "take":        {"family": "inventory", "args": [{"name": "item", "type": "item"}], "kw": {"n": "int", "chest": "target"}, "doc": "take items from a chest"},
    "sort":        {"family": "inventory", "args": [], "kw": {}, "doc": "compact the inventory"},
    "toss_junk":   {"family": "inventory", "args": [], "kw": {"keep": "item_list"}, "doc": "drop items not on the keep list"},
    "keep":        {"family": "inventory", "args": [{"name": "items", "type": "item_list"}], "kw": {}, "doc": "set the keep list"},

    "plant":       {"family": "farm", "args": [{"name": "seed", "type": "item"}], "kw": {"at": "posset"}, "doc": "plant on farmland"},
    "bonemeal":    {"family": "farm", "args": [{"name": "target", "type": "target"}], "kw": {}, "doc": "use bone meal"},
    "breed":       {"family": "farm", "args": [{"name": "target", "type": "mob"}], "kw": {"n": "int"}, "doc": "feed pairs of animals"},
    "lead":        {"family": "farm", "args": [{"name": "target", "type": "entity|mob"}], "kw": {}, "doc": "attach a lead"},
    "tame":        {"family": "farm", "args": [{"name": "target", "type": "entity|mob"}], "kw": {}, "doc": "tame (wolf, cat, horse...)"},
    "feed":        {"family": "farm", "args": [{"name": "target", "type": "entity|mob"}, {"name": "item", "type": "item"}], "kw": {}, "doc": "give food to an animal"},

    "say":         {"family": "social", "args": [{"name": "text", "type": "text"}], "kw": {}, "doc": "public chat"},
    "whisper":     {"family": "social", "args": [{"name": "to", "type": "entity"}, {"name": "text", "type": "text"}], "kw": {}, "doc": "private message"},
    "give":        {"family": "social", "args": [{"name": "to", "type": "entity"}, {"name": "item", "type": "item"}], "kw": {"n": "int"}, "doc": "walk to a player and toss items"},
    "come_to":     {"family": "social", "args": [{"name": "to", "type": "entity"}], "kw": {"dist": "num"}, "doc": "go next to a player"},
    "obey":        {"family": "social", "args": [], "kw": {}, "doc": "accept the last order (it becomes the top goal)"},
    "refuse":      {"family": "social", "args": [{"name": "reason", "type": "text"}], "kw": {}, "doc": "decline the last order, with a reason"},

    "wait":        {"family": "meta", "args": [{"name": "dur", "type": "duration"}], "kw": {}, "doc": "do nothing"},
    "note":        {"family": "meta", "args": [{"name": "text", "type": "text"}], "kw": {"key": "name"}, "doc": "write a long-term memory line"},
    "forget":      {"family": "meta", "args": [{"name": "key", "type": "name"}], "kw": {}, "doc": "delete a memory line, place or routine"},
    "name_place":  {"family": "meta", "args": [{"name": "name", "type": "name"}], "kw": {"at": "target"}, "doc": "remember a place as @name (here by default)"},
    "save_routine":{"family": "meta", "args": [{"name": "name", "type": "name"}, {"name": "body", "type": "stmt"}], "kw": {}, "doc": "save a statement, run it later with `routine name`"},
    "stop":        {"family": "meta", "args": [], "kw": {}, "doc": "stop the running action"}
  },
  "tools": {
    "recipe":      {"args": [{"name": "item", "type": "item"}], "kw": {}, "doc": "how to make it (all recipes, station, missing items now)"},
    "uses":        {"args": [{"name": "item", "type": "item"}], "kw": {}, "doc": "what it is used for"},
    "where":       {"args": [{"name": "target", "type": "target"}], "kw": {"n": "int"}, "doc": "known locations (seen by the bot), nearest first"},
    "scan":        {"args": [], "kw": {"radius": "int", "filter": "query"}, "doc": "list visible blocks/entities around"},
    "path_cost":   {"args": [{"name": "target", "type": "target"}], "kw": {}, "doc": "distance, estimated time, obstacles"},
    "inv":         {"args": [], "kw": {}, "doc": "full inventory with slots and durability"},
    "chest":       {"args": [{"name": "at", "type": "target"}], "kw": {}, "doc": "last known content of a chest"},
    "recall":      {"args": [{"name": "query", "type": "query"}], "kw": {}, "doc": "search long-term memory and past episodes"},
    "wiki":        {"args": [{"name": "query", "type": "query"}], "kw": {}, "doc": "Minecraft knowledge base"},
    "mob_info":    {"args": [{"name": "mob", "type": "mob"}], "kw": {}, "doc": "behaviour, hp, damage, drops"},
    "loot":        {"args": [{"name": "block", "type": "block"}], "kw": {}, "doc": "what breaking it drops, with which tool"},
    "biome_info":  {"args": [{"name": "biome", "type": "biome"}], "kw": {}, "doc": "biome facts"},
    "simulate":    {"args": [{"name": "body", "type": "stmt"}], "kw": {}, "doc": "feasibility only: missing items, unreachable targets, estimated duration"}
  },
  "results": ["ok", "partial", "failed", "interrupted"],
  "failure_causes": ["no_target_known", "no_path", "unreachable", "timeout", "missing_items", "missing_tool",
    "tool_too_weak", "inventory_full", "interrupted_until", "interrupted_by_model", "danger", "died", "invalid",
    "server_refused"]
}
