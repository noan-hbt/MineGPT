  ],
  "limits": {
    "ticks": 1200,
    "decisions": 20
  },
  "solution": [
    "wait 1s",
    "avoid #enderman radius=6",
    "chop n=1 species=${wood}_log",
    "collect ${wood}_log radius=8"
