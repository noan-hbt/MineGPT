      {
        "container": "<6,0,${z}>",
        "item": "${item}",
        "min": "${n}",
        "max": "${n}"
      },
      {
        "container": "<-6,0,${z}>",
        "item": "apple",
        "min": 5,
        "max": 5
      },
      {
        "container": "<6,0,${z}>",
        "item": "bread",
        "min": 3,
        "max": 3
      },
      {
        "have": "${item}",
        "min": 0,
        "max": 0
      },
      {
        "have": "stone_pickaxe",
        "min": 1,
        "max": 1
      }
    ]
  },
  "fail": {
    "died": true
  },
  "milestones": [
    {
      "name": "taken_from_a",
      "check": {
        "have": "${item}",
        "min": "${n}",
        "max": "${n}"
      }
    },
    {
      "name": "delivered_to_b",
      "check": {
        "container": "<6,0,${z}>",
        "item": "${item}",
        "min": "${n}",
        "max": "${n}"
      }
    }
  ],
  "limits": {
    "ticks": 1400,
    "decisions": 20
  },
  "solution": [
    "take ${item} n=${n} chest=<-6,0,${z}>",
    "store chest=<6,0,${z}> filter=[${item}]"
