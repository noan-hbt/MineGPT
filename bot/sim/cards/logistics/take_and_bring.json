{
  "card": 1,
  "id": "logistics.take_and_bring",
  "title": "Move a requested quantity from chest A into chest B",
  "tags": [
    "logistics"
  ],
  "difficulty": 3,
  "split": "train",
  "seeds": [
    1,
    2,
    3,
    4
  ],
  "params": {
    "z": {
      "int": [
        -5,
        5
      ]
    },
    "item": {
      "choice": [
        "iron_ingot",
        "copper_ingot",
        "oak_log"
      ]
    },
    "n": {
      "int": [
        4,
        16
      ]
    },
    "left": {
      "int": [
        2,
        7
      ]
    }
  },
  "world": {
    "template": "arena",
    "time": 1000,
    "weather": "clear",
    "difficulty": "easy",
    "gamerules": {
      "advance_time": false,
      "advance_weather": false,
      "keep_inventory": false,
      "mob_griefing": false
    }
  },
  "player": {
