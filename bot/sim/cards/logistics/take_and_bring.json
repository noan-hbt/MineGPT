  "build": [
    {
      "container": "<-6,0,${z}>",
      "block": "chest[facing=south]",
      "items": [
        {
          "item": "${item}",
          "count": "${total}",
          "slot": 0
        },
        {
          "item": "apple",
          "count": 5,
          "slot": 1
        }
      ]
    },
    {
      "container": "<6,0,${z}>",
      "block": "chest[facing=south]",
      "items": [
        {
          "item": "bread",
          "count": 3,
          "slot": 0
        }
      ]
    }
  ],
  "mind": {
    "places": {
      "a": "<-6,0,${z}>",
      "b": "<6,0,${z}>"
    }
